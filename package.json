{
  "name": "coordinate-first-quadrant",
  "version": "2.0.0",
  "description": "מערכת צירים — הרביע הראשון: 78 עמודים ממוספרים להדפסה, חוברת דיגיטלית, מובייל והדפסת A4.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4319 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:visual",
    "pdf": "node scripts/build-pdf.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^26.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "pdf-lib": "^1.17.1"
  }
}
